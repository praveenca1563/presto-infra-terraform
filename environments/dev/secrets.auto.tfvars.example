# Copy this file to secrets.auto.tfvars for local runs and fill in real values,
# OR (preferred) don't create this file at all and instead export TF_VAR_ environment
# variables / configure them as CI secrets. secrets.auto.tfvars is git-ignored.

azure_subscription_id = "d6a52cfa-d4f3-4835-ae58-fb4bbc6905ee"
azure_tenant_id        = "a2960a6b-402a-4eb4-b6c5-867bc1a95d4f"
azure_client_id         = "499535d3-6ce5-4265-9d3c-8ff7dcf1e9a5"
azure_client_secret    = "<rotate-and-fill-in-do-not-commit>"

github_owner = "<your-github-org-or-user>"
github_token = "<github-pat-or-app-token-with-repo-admin-scope>"

runner_ssh_public_key      = "ssh-rsa AAAA... your-runner-vm-ssh-key"
runner_registration_token  = "<short-lived-github-runner-registration-token>"
